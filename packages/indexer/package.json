{
  "name": "@packages/indexer",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --fix --max-warnings=0",
    "create-index": "tsx scripts/create-index.ts",
    "search-playground": "tsx scripts/search-playground.ts"
  },
  "lint-staged": {
    "*": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "prettier": "@packages/prettier-config",
  "dependencies": {
    "@packages/types": "workspace:*",
    "@packages/data": "workspace:*",
    "tsx": "4.20.6"
  }
}
